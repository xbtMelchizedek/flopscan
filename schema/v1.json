{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xbtmelchizedek.github.io/flopscan/schema/v1.json",
  "title": "flopscan v1 snapshot",
  "description": "Reconciled FLOP devnet metrics. A metric has a value only when two independent sources agree. Amounts are integer strings in planck (1 FLOP = 10^18 planck). Devnet data, not financial information, unaudited.",
  "type": "object",
  "required": ["$schema", "schema_version", "generator", "network", "generated_at_utc", "as_of", "window", "sources", "summary", "disclaimer", "metrics"],
  "additionalProperties": false,
  "definitions": {
    "int": { "type": "string", "pattern": "^-?[0-9]+$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "block": {
      "type": ["object", "null"],
      "required": ["block", "hash", "time_utc"],
      "properties": { "block": { "type": "integer", "minimum": 0 }, "hash": { "$ref": "#/definitions/hash" }, "time_utc": { "anyOf": [{ "$ref": "#/definitions/utc" }, { "type": "null" }] } }
    },
    "status": { "enum": ["match", "mismatch", "pending"] },
    "reading": {
      "type": "object",
      "required": ["source", "value"],
      "properties": {
        "source": { "enum": ["rpc.storage", "rpc.keys", "rpc.events", "rpc.runtime", "explorer", "schedule", "ghcr", "faucet-service"] },
        "value": { "type": ["string", "null"] },
        "label": { "type": "string" },
        "block": { "type": "integer" },
        "hash": { "$ref": "#/definitions/hash" },
        "context": { "type": "boolean" }
      }
    },
    "scalar": {
      "type": "object",
      "required": ["id", "group", "title", "unit", "status", "value", "method", "readings"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_]+\\.[A-Za-z0-9_.-]+$" },
        "group": { "type": "string" },
        "title": { "type": "string" },
        "unit": { "enum": ["FLOP", "count", "text"] },
        "status": { "$ref": "#/definitions/status" },
        "value": { "type": ["string", "null"] },
        "method": { "type": "string" },
        "delta": { "type": ["string", "null"] },
        "readings": { "type": "array", "items": { "$ref": "#/definitions/reading" } },
        "note": { "type": "string" },
        "last_match": { "type": "object", "required": ["value", "block"], "properties": { "value": { "type": "string" }, "block": { "type": ["integer", "null"] }, "time_utc": { "type": ["string", "null"] } } }
      },
      "if": { "properties": { "status": { "const": "match" } } },
      "then": { "properties": { "value": { "type": "string" } } },
      "else": { "properties": { "value": { "type": "null" } } }
    },
    "table": {
      "type": "object",
      "required": ["id", "group", "kind", "title", "status", "columns", "rows"],
      "properties": {
        "kind": { "const": "table" },
        "status": { "$ref": "#/definitions/status" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "properties": {
    "$schema": { "const": "https://xbtmelchizedek.github.io/flopscan/schema/v1.json" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "generator": { "const": "flopscan" },
    "network": { "const": "devnet" },
    "generated_at_utc": { "$ref": "#/definitions/utc" },
    "as_of": { "$ref": "#/definitions/block" },
    "window": { "type": "object", "required": ["lo", "hi"], "properties": { "lo": { "$ref": "#/definitions/block" }, "hi": { "$ref": "#/definitions/block" } } },
    "sources": { "type": "object", "required": ["rpc", "explorer", "errors"] },
    "summary": { "type": "object", "required": ["match", "mismatch", "pending"], "properties": { "match": { "type": "integer" }, "mismatch": { "type": "integer" }, "pending": { "type": "integer" } } },
    "disclaimer": { "type": "string", "minLength": 10 },
    "metrics": { "type": "array", "items": { "anyOf": [{ "$ref": "#/definitions/table" }, { "$ref": "#/definitions/scalar" }] } }
  }
}
